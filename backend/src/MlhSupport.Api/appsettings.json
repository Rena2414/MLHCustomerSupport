{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "AgentService": {
    "BaseUrl": "http://localhost:8000",
    "TimeoutSeconds": 240
  },
  "Jwt": {
    "Issuer": "classly-api",
    "Audience": "classly-web",
    "LifetimeHours": 12
  }
}
